---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { languages, switchLangPath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const t = useTranslations(lang);

const pageTitle = `${title} | Sarah Mertens`;
const pageDescription = description ?? t('site.description');
const alternates = (Object.keys(languages) as Lang[]).map((l) => ({
  lang: l,
  href: new URL(switchLangPath(Astro.url.pathname, l), Astro.site).href,
}));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only rounded-theme bg-fg px-4 py-2 text-bg focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50"
    >
      {t('skip')}
    </a>
    <Header lang={lang} />
    <main id="main" class="mx-auto w-full max-w-content flex-1 px-4 py-8">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>