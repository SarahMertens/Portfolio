---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DivingScene from '../components/themes/DivingScene.astro';
import GuitarScene from '../components/themes/GuitarScene.astro';
import ControlScene from '../components/themes/ControlScene.astro';
import { getScene } from '../components/themes/scenes';
import { defaultTheme, themes } from '../themes';
import { languages, switchLangPath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const t = useTranslations(lang);
const scene = getScene(Astro.url.pathname);

const pageTitle = `${title} | Sarah Mertens`;
const pageDescription = description ?? t('site.description');
const alternates = (Object.keys(languages) as Lang[]).map((l) => ({
  lang: l,
  href: new URL(switchLangPath(Astro.url.pathname, l), Astro.site).href,
}));
---

<!doctype html>
<html lang={lang} data-theme={defaultTheme} data-scene={scene}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Het gekozen thema meteen zetten, nog voor de pagina getekend wordt (anders flitst het standaardthema) -->
    <script is:inline define:vars={{ themeIds: themes.map((theme) => theme.id) }}>
      try {
        const saved = localStorage.getItem('theme');
        if (saved && themeIds.includes(saved)) document.documentElement.dataset.theme = saved;
      } catch {
        // Geen localStorage (bv. privévenster met strenge instellingen): standaardthema blijft
      }
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <DivingScene />
    <GuitarScene lang={lang} />
    <ControlScene lang={lang} />
    <a
      href="#main"
      class="sr-only rounded-theme bg-fg px-4 py-2 text-bg focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50"
    >
      {t('skip')}
    </a>
    <Header lang={lang} />
    <main id="main" class="mx-auto w-full max-w-content flex-1 px-4 py-8">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>