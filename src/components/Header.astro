---
import { switchLangPath, useTranslations, type Lang, type UiKey } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const links: { path: string; label: UiKey }[] = [
  { path: '', label: 'nav.home' },
  { path: 'projects', label: 'nav.projects' },
  { path: 'about', label: 'nav.about' },
  { path: 'contact', label: 'nav.contact' },
];

const normalize = (path: string) => path.replace(/\/$/, '');
const currentPath = normalize(Astro.url.pathname);

const otherLang: Lang = lang === 'nl' ? 'en' : 'nl';
const otherLangHref = switchLangPath(Astro.url.pathname, otherLang);
---

<header class="site-header">
  <a class="logo" href={`/${lang}/`}>SM</a>

  <nav aria-label={t('nav.label')}>
    <ul>
      {
        links.map(({ path, label }) => {
          const href = normalize(`/${lang}/${path}`);
          return (
            <li>
              <a href={`${href}/`} aria-current={currentPath === href ? 'page' : undefined}>
                {t(label)}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>

  <a class="lang-switch" href={otherLangHref} hreflang={otherLang} lang={otherLang} title={t('lang.switch')}>
    {otherLang.toUpperCase()}
  </a>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    gap: var(--space-l);
    padding: var(--space-m);
    border-bottom: 1px solid var(--color-border);
  }

  .logo {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.25rem;
    text-decoration: none;
    color: var(--color-text);
  }

  nav {
    flex: 1;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    color: var(--color-text);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .lang-switch {
    padding: var(--space-xs) var(--space-s);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text);
    text-decoration: none;
    font-family: var(--font-mono);
  }
</style>