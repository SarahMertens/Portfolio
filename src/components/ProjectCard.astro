---
import { Image } from 'astro:assets';
import TechList from './TechList.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { projectSlug, type Project } from '../lib/projects';

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const { title, summary, tech, year, context, cover, coverAlt, demo } = project.data;
const t = useTranslations(lang);
const href = `/${lang}/projects/${projectSlug(project)}/`;
---

<article
  class="glass group relative flex flex-col overflow-hidden rounded-theme border border-line bg-surface transition hover:border-accent hover:shadow-[0_0_28px_-8px_var(--color-accent)]"
>
  {
    cover && (
      <Image src={cover} alt={coverAlt ?? ''} class="aspect-video w-full object-cover" widths={[400, 800]} sizes="(min-width: 768px) 400px, 100vw" />
    )
  }

  <div class="flex flex-1 flex-col gap-3 p-4">
    <div class="flex items-center justify-between gap-2">
      <p class="font-mono text-xs text-muted">
        {year} · {t(`context.${context}`)}
      </p>
      {
        demo && (
          <span class="rounded-full border border-accent px-2 py-0.5 font-mono text-xs text-accent">
            ▶ {t('project.live')}
          </span>
        )
      }
    </div>

    <h3 class="mb-0">
      <a href={href} class="text-fg no-underline after:absolute after:inset-0 group-hover:text-accent">
        {title}
      </a>
    </h3>

    <p class="flex-1 text-muted">{summary}</p>

    <TechList tech={tech} label={t('project.tech')} />
  </div>
</article>