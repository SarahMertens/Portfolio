---
interface Props {
  tech: string[];
  label: string;
}

const { tech, label } = Astro.props;
---

<ul class="flex flex-wrap gap-2" aria-label={label}>
  {
    tech.map((item) => (
      <li class="rounded-theme border border-line bg-surface px-2 py-0.5 font-mono text-xs text-muted">{item}</li>
    ))
  }
</ul>