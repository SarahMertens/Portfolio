---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangPaths, useTranslations, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return getLangPaths();
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('thanks.title')}>
  <!-- Google hoeft deze pagina niet te tonen -->
  <meta slot="head" name="robots" content="noindex" />
  <section class="py-16 text-center">
    <h1>{t('thanks.title')}</h1>
    <p class="mb-8 text-lg text-muted">{t('thanks.text')}</p>
    <a href={`/${lang}/`}>← {t('thanks.back')}</a>
  </section>
</BaseLayout>