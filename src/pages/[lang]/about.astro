---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TechList from '../../components/TechList.astro';
import Timeline from '../../components/Timeline.astro';
import { about } from '../../data/about';
import { getLangPaths, useTranslations, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return getLangPaths();
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const content = about[lang];
---

<BaseLayout lang={lang} title={t('about.title')} description={t('about.intro')}>
  <h1>{t('about.title')}</h1>
  <p class="mb-10 text-lg text-muted">{t('about.intro')}</p>

  <div class="grid gap-12 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
    <div>
      <!-- Mijn verhaal -->
      <section class="mb-12 max-w-prose space-y-4 text-lg leading-relaxed">
        {content.story.map((paragraph) => <p>{paragraph}</p>)}
      </section>

      <!-- Vaardigheden -->
      <section aria-labelledby="skills-title" class="mb-12">
        <h2 id="skills-title">{t('about.skills')}</h2>
        <div class="grid gap-5 sm:grid-cols-2">
          {
            content.skills.map((group) => (
              <div>
                <h3 class="text-base">{group.name}</h3>
                <TechList tech={group.items} label={group.name} />
              </div>
            ))
          }
        </div>
      </section>

      <!-- Tijdlijn -->
      <div class="grid gap-10 sm:grid-cols-2">
        <Timeline title={t('about.education')} items={content.education} />
        <Timeline title={t('about.work')} items={content.work} />
      </div>
    </div>

    <!-- Zijkolom met korte feiten -->
    <aside class="space-y-8">
      <section class="rounded-theme border border-line bg-surface p-5">
        <h2 class="text-xl">{t('about.certificates')}</h2>
        <ul class="list-disc space-y-1 pl-5">
          {content.certificates.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="rounded-theme border border-line bg-surface p-5">
        <h2 class="text-xl">{t('about.languages')}</h2>
        <dl class="grid grid-cols-[1fr_auto] gap-y-1">
          {
            content.languages.map(({ name, level }) => (
              <>
                <dt>{name}</dt>
                <dd class="text-muted">{level}</dd>
              </>
            ))
          }
        </dl>
      </section>

      <section class="rounded-theme border border-line bg-surface p-5">
        <h2 class="text-xl">{t('about.hobbies')}</h2>
        <ul class="list-disc space-y-1 pl-5">
          {content.hobbies.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    </aside>
  </div>

  <p class="mt-14 text-lg">
    {t('about.cta')} <a href={`/${lang}/projects/`}>{t('home.ctaProjects')} →</a>
  </p>
</BaseLayout>