---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangPaths, useTranslations, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return getLangPaths();
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('about.title')}>
  <h1>{t('about.title')}</h1>
</BaseLayout>